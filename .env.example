# Local development only. Do not use this password on a public server.
POSTGRES_DB=company_memory
POSTGRES_USER=company_memory
POSTGRES_PASSWORD=local_development_only
# MAX bot. Required only to run the bot adapter (backend/app/bot), not the API.
MAX_BOT_TOKEN=
# Path to a CA bundle trusting the Russian Trusted Root CA, which signs the MAX
# API certificate. Without it the bot cannot connect; see backend/app/bot/README.md.
MAX_API_CA_BUNDLE=
# Development-only: accept the X-Demo-User-Id header as the acting user on the
# HTTP API. Never set in production — it trusts whatever the caller sends, and
# leaving it unset is what keeps a public run closed (see contracts/README.md).
ALLOW_DEMO_IDENTITY=false
# Reserved for future AI integration; not required by the scaffold.
LLM_API_KEY=
