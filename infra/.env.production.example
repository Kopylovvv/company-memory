DOMAIN=bot.example.ru
POSTGRES_DB=company_memory
POSTGRES_USER=company_memory
POSTGRES_PASSWORD=replace_with_a_long_random_value
MAX_BOT_TOKEN=replace_on_the_server
# YandexGPT for AI drafts, read by the `bot` service only. Both are needed; with
# either one empty the bot preserves the source as an empty draft and reports
# that AI is unavailable.
# LLM_API_KEY: secret of a service-account API key (role ai.languageModels.user,
# scope yc.ai.foundationModels.execute), starts with AQVN. Enter it on the server.
LLM_API_KEY=
# YANDEX_FOLDER_ID: ID of the Yandex Cloud folder with that service account, b1g...
YANDEX_FOLDER_ID=
